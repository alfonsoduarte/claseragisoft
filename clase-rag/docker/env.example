# -------------------------------------------------------------------
# Copia este archivo a .env y genera la clave de cifrado:
#
#   cp env.example .env
#   echo "N8N_ENCRYPTION_KEY=$(openssl rand -hex 32)" >> .env
#
# .env NO se sube al repositorio (esta en .gitignore).
# -------------------------------------------------------------------

# Puerto donde vas a abrir el editor de n8n. 5679 para no
# chocar con un n8n que ya tengas escuchando en el 5678.
N8N_PORT=5679

# Cifra las credenciales guardadas en n8n. Obligatoria.
# Si la perdes, las credenciales guardadas dejan de poder
# descifrarse y hay que volver a cargarlas.
N8N_ENCRYPTION_KEY=

# Zona horaria. Importa para las fechas que guardamos
# como metadata de cada chunk.
TZ=America/Mexico_City

# --- Base interna de n8n (NO es la base vectorial) ----------------
N8N_DB=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=n8n

# --- Base vectorial (pgvector) ------------------------------------
VECTOR_DB=ragdb
VECTOR_USER=raguser
VECTOR_PASSWORD=ragpass
VECTOR_PORT=5433

# Red de un n8n ya existente. Solo lo usa
# docker-compose.vectorstore.yml
#   docker network ls | grep -i n8n
N8N_NETWORK=n8n_default
